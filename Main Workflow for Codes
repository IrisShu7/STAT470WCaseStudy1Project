
```{r}
world_castles <- tuesdata$world_castles
```

```{r}
library(ggplot2)
library(tidyr)

ggplot(world_castles, aes(x = category)) +
  geom_bar() +
  labs(
    title = "Number of Castles by Category",
    x = "Category",
    y = "Count"
  )
```


```{r}
ggplot(world_castles, aes(x = century)) +
  geom_bar() +
  labs(
    title = "Number of Landmarks by Century",
    x = "Century",
    y = "Count"
  ) +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1)
  )

ggplot(country_counts, aes(x = reorder(country, n), y = n)) +
  geom_col() +
  coord_flip() +
  labs(
    title = "Top 10 Countries by Number of Landmarks",
    x = "Country",
    y = "Count"
  )
```



